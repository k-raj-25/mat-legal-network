{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "FLASK_APP": "wsgi:app",
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "DATABASE_URL": "postgresql+psycopg://mat:mat@localhost:5432/mat_legal"
      },
      "args": [
        "run",
        "--host",
        "0.0.0.0",
        "--port",
        "5000",
        "--no-debugger"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Flask: run.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "0",
        "DATABASE_URL": "postgresql+psycopg://mat:mat@localhost:5432/mat_legal"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": ["-q"],
      "justMyCode": true
    }
  ]
}
